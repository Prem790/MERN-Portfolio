# MongoDB connection string (rotate the password if it was ever committed!)
mongo_url=your_mongodb_connection_string_here

# Server port (optional, defaults to 5000)
PORT=5000

# Secret used to sign JWT auth tokens. Use a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# How long an admin login stays valid
JWT_EXPIRES_IN=2h

# Allowed frontend origin(s) for CORS, comma-separated
CLIENT_URL=https://mern-portfolio-client-yaps.onrender.com

# Used only by scripts/seedAdmin.js to create/update the admin user
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_strong_password
